rules_version = '2';

// ONE rules file for the whole Firebase project: Cash Curry v2 AND the POS
// share it. Deploy only this file (from cash_curry_v2); the POS repo's copy is
// retired — deploying either app's own version would lock the other out.
//
// These rules are the security boundary. Screens and middleware only hide
// buttons; anyone can call Firestore directly. Tests: npm run test:rules.
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────────────────
    // Helper Functions
    // ─────────────────────────────────────────────────────────────────────────

    // Fetch the authenticated user's metadata from the global users collection
    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Does the user belong to this company?
    function belongsToCompany(companyId) {
      return isAuth() && userData().companyId == companyId;
    }

    // Is the user an owner of this company?
    function isOwner(companyId) {
      return isAuth() && userData().companyId == companyId && userData().role == 'owner';
    }

    // Company-level administrator: owner or superAdmin.
    // superAdmin sits above branches (same as in canWrite), so anything the
    // owner may do to company/branch/user records, a superAdmin may do too.
    // Legacy all-lowercase 'superadmin' is accepted for pre-existing user docs.
    function isCompanyAdmin(companyId) {
      let u = userData();
      return isAuth() && u.companyId == companyId &&
        u.role in ['owner', 'superAdmin', 'superadmin'];
    }

    // Owner, GM and super admin work across every branch of their company.
    function isCompanyWide(u) {
      return u.role in ['owner', 'gm', 'superAdmin', 'superadmin'];
    }

    // The user's assigned branch (null when none — such a user reads no branch).
    function inBranch(u, branchId) {
      return u.get('branchId', null) == branchId;
    }

    // Can the user READ this branch's finance and operations data?
    // - owner / gm / superAdmin: every branch in their company
    // - other roles: their assigned branch only — except staff, who see only
    //   what is theirs (own staff record, own requests) and the branch's chat/feed
    // (There used to be a fallback letting any user without a branchId read
    // every branch; every real branch user has one.)
    function canRead(companyId, branchId) {
      let u = userData();
      return isAuth() && u.companyId == companyId && (
        isCompanyWide(u) ||
        (inBranch(u, branchId) && u.role != 'staff')
      );
    }

    // Anyone who works at this branch, staff included (chat, wall, requests).
    function isBranchMember(companyId, branchId) {
      let u = userData();
      return isAuth() && u.companyId == companyId && (isCompanyWide(u) || inBranch(u, branchId));
    }

    // Normalises legacy lowercase "branchadmin" to canonical "branchAdmin".
    // All new users are stored with camelCase; this handles existing data.
    function isBranchAdmin(u) {
      return u.role == 'branchAdmin' || u.role == 'branchadmin';
    }

    // Can the user WRITE (create/update/delete) to this branch?
    // - owner: full access to all branches
    // - branchAdmin, manager, accountant, supervisor: CRUD on their assigned branch only
    // - staff: no write access ever
    function canWrite(companyId, branchId) {
      let u = userData();
      return isAuth() && u.companyId == companyId && (
        u.role in ['owner', 'gm', 'superAdmin', 'superadmin'] ||
        (
          (isBranchAdmin(u) || u.role in ['manager', 'inCharge', 'accountant', 'supervisor']) &&
          inBranch(u, branchId)
        )
      );
    }

    // Who may operate a till: everyone from cashier up. Mirrors the existing
    // orders rule so the POS subtree does not invent a second answer.
    function canOperatePos(companyId, branchId) {
      let u = userData();
      return isAuth() && u.companyId == companyId && (
        u.role == 'owner' ||
        (
          (isBranchAdmin(u) || u.role in ['manager', 'supervisor', 'cashier', 'accountant']) &&
          u.branchId == branchId
        )
      );
    }

    // Who may configure a branch's POS: manager and above. Menu prices, floor
    // plans and till logins are not a cashier's to change.
    function canConfigurePos(companyId, branchId) {
      let u = userData();
      return isAuth() && u.companyId == companyId && (
        u.role == 'owner' ||
        u.role == 'gm' ||
        u.role == 'superAdmin' ||
        ((isBranchAdmin(u) || u.role == 'manager') && u.branchId == branchId)
      );
    }

    // ── Advances and staff loans: requested → approved → paid ──────────────
    // Approve or reject; record one handed over on the spot; delete.
    function isApprover(companyId, branchId) {
      let u = userData();
      return isAuth() && u.companyId == companyId && (
        isCompanyWide(u) ||
        ((isBranchAdmin(u) || u.role == 'manager') && inBranch(u, branchId))
      );
    }

    // Hand over approved money (records paidOut).
    function isPayer(companyId, branchId) {
      let u = userData();
      return isAuth() && u.companyId == companyId && (
        isCompanyWide(u) ||
        ((isBranchAdmin(u) || u.role in ['manager', 'accountant', 'supervisor', 'cashier']) && inBranch(u, branchId))
      );
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // A row about the signed-in staff member: its staffId is the staff record
    // their login is linked to (users/{uid}.staffId — only an admin sets it).
    // Queries must filter on exactly that staffId, or Firestore refuses them.
    function isOwnStaffRecord() {
      let mine = userData().get('staffId', '');
      return mine != '' && resource.data.get('staffId', '') == mine;
    }

    // A staff member's own advance or loan: one they asked for, or one
    // entered for them.
    function isOwnRequest() {
      return resource.data.get('createdBy', {}).get('uid', '') == request.auth.uid || isOwnStaffRecord();
    }

    // A request as anyone may raise it: pending, nothing paid.
    function isNewRequest() {
      return request.resource.data.get('status', '') == 'pending' &&
        request.resource.data.get('paidOut', null) == null &&
        request.resource.data.get('approvals', []).size() == 0;
    }

    // Whoever asked may cancel it while it still waits — nothing else changes.
    function isCancel() {
      return resource.data.get('status', '') == 'pending' &&
        request.resource.data.get('status', '') == 'cancelled' &&
        changedKeys().hasOnly(['status', 'cancelledBy', 'updatedAt']);
    }

    // Paying out: an approved, unpaid request gets paidOut — and nothing else
    // changes (not the amount, not who it is for).
    function isPayOut() {
      return resource.data.get('status', '') == 'approved' &&
        resource.data.get('paidOut', null) == null &&
        request.resource.data.get('paidOut', null) != null &&
        changedKeys().hasOnly(['paidOut', 'paidFromOffice', 'updatedAt']);
    }

    // Accountant / supervisor keeping the books (installments, totals, notes):
    // never who approved it, whether it is paid, the amount, or the staff
    // member — though a fully repaid one may go from approved to closed.
    function isBookkeeping() {
      return !changedKeys().hasAny(['approvedBy', 'paidOut', 'paidFromOffice', 'amount', 'staffId', 'createdBy']) &&
        (!changedKeys().hasAny(['status']) ||
          (resource.data.get('status', '') == 'approved' && request.resource.data.get('status', '') == 'closed'));
    }

    // Settings fields that decide money and dates: branch admins and above only.
    function keepsMoneySettings() {
      let before = resource.data;
      let after = request.resource.data;
      return after.get('financeSales', {}).get('openingBalance', null) == before.get('financeSales', {}).get('openingBalance', null) &&
        after.get('financeSales', {}).get('openingBankBalance', null) == before.get('financeSales', {}).get('openingBankBalance', null) &&
        after.get('financeSales', {}).get('currency', null) == before.get('financeSales', {}).get('currency', null) &&
        after.get('initialCash', null) == before.get('initialCash', null) &&
        after.get('basic', {}).get('timeZone', null) == before.get('basic', {}).get('timeZone', null) &&
        after.get('attendance', {}).get('dayCutoffTime', null) == before.get('attendance', {}).get('dayCutoffTime', null);
    }

    // Can the user manage branch settings? (owner / superAdmin, or this branch's admin)
    function canManageSettings(companyId, branchId) {
      let u = userData();
      return isAuth() && u.companyId == companyId && (
        u.role in ['owner', 'superAdmin', 'superadmin'] ||
        (isBranchAdmin(u) && u.branchId == branchId)
      );
    }

    // Managers are given a restricted slice of /branch-settings by the UI
    // (see app/components/settings/rolePolicy.js: contact details, tender
    // labels/order, reporting defaults, notes). They are routed there by
    // middleware.js too, so they need write access to the settings DOCUMENT —
    // but not to branch metadata, which stays with canManageSettings.
    // Money and date settings (opening balances, currency, time zone, day
    // cut-off) are enforced here too: a manager's save may not change them.
    function canWriteBranchSettings(companyId, branchId) {
      return canMoneySettings(companyId, branchId) ||
        (canBranchSettings(companyId, branchId) && (resource == null || keepsMoneySettings()));
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Public Collections (no auth required)
    // ─────────────────────────────────────────────────────────────────────────

    // Invite codes for company signup — readable by anyone to validate,
    // only writable by platform admins (create / delete unused) or by the
    // signup flow (consuming a code = flipping used:false to used:true).
    function isPlatformAdmin() {
      return isAuth() && userData().get('platformAdmin', false) == true;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // The roles matrix (docs/ROLES.md, lib/authz/permissions.js — agreed
    // 18 Oct 2026). One function per capability; tests-rules/matrix.test.js
    // checks each against lib/authz/permissions.js, so the two can't drift.
    // Company roles act in any branch of their company; branch roles only in
    // their own. Old spellings (superadmin, branchadmin) count as the new ones.
    // ─────────────────────────────────────────────────────────────────────────
    function companyRoles() { return ['owner', 'superAdmin', 'superadmin', 'gm']; }
    function leadRoles() { return ['branchAdmin', 'branchadmin', 'manager']; }
    function officeBranchRoles() { return ['branchAdmin', 'branchadmin', 'manager', 'inCharge', 'accountant', 'supervisor', 'cashier']; }

    // the signed-in user may act with `branchRoles` in this branch, or is a company role
    function may(companyId, branchId, branchRoles) {
      let u = userData();
      return isAuth() && u.companyId == companyId && (
        u.role in companyRoles() ||
        (inBranch(u, branchId) && u.role in branchRoles)
      );
    }
    // company-level records (vendors, items, branch loans): the role, in any branch
    function mayInCompany(companyId, branchRoles) {
      let u = userData();
      return isAuth() && u.companyId == companyId && (u.role in companyRoles() || u.role in branchRoles);
    }

    function canReportsView(c, b)     { return may(c, b, leadRoles().concat(['inCharge', 'accountant'])); }
    function canSalesEnter(c, b)      { return may(c, b, officeBranchRoles()); }
    function canCostsEnter(c, b)      { return may(c, b, leadRoles().concat(['inCharge', 'accountant'])); }
    function canCostsApprove(c, b)    { return may(c, b, leadRoles().concat(['inCharge'])); }
    function canPayoutsHandOut(c, b)  { return may(c, b, leadRoles().concat(['inCharge', 'supervisor', 'cashier'])); }
    // ── a pay-out spent at a supplier (4.10, lib/payouts/supplier.js) ──
    // those who hand out or approve pay-outs, in any branch of the company
    function canPayoutsAny(c) { return mayInCompany(c, leadRoles().concat(['inCharge', 'supervisor', 'cashier'])); }
    function canCostsApproveAny(c) { return mayInCompany(c, leadRoles().concat(['inCharge'])); }
    // the pay-out bill `settleId` ends this write approved, with a supplier — the
    // supplier's bills, payment and balance may move only as part of that
    function supplierPayoutApproved(c, b, settleId) {
      let after = getAfter(/databases/$(database)/documents/companies/$(c)/branches/$(b)/payouts/$(settleId)).data;
      return after.get('status', '') == 'approved' && after.get('supplier', null) != null;
    }
    // a cost's voucher moving to approved / rejected in this write
    function voucherDecided() {
      let before = resource.data.get('voucher', {}).get('status', '');
      let after = request.resource.data.get('voucher', {}).get('status', '');
      return after != before && (after == 'approved' || after == 'rejected');
    }
    function voucherMaker() {
      return resource.data.get('voucher', {}).get('by', {}).get('uid', resource.data.get('createdBy', {}).get('uid', ''));
    }
    function canCashBank(c, b)        { return may(c, b, leadRoles().concat(['accountant'])); }
    function canSalariesEnter(c, b)   { return may(c, b, leadRoles().concat(['accountant'])); }
    function canAdvancesRequest(c, b) { return may(c, b, officeBranchRoles()); }
    function canAdvancesPayOut(c, b)  { return may(c, b, leadRoles().concat(['accountant', 'supervisor', 'cashier'])); }
    function canAdvancesApprove(c, b) { return may(c, b, leadRoles()); }
    function canPayrollView(c, b)     { return may(c, b, leadRoles().concat(['accountant'])); }
    function canPayrollManage(c, b)   { return may(c, b, leadRoles()); }
    function canStaffView(c, b)       { return may(c, b, officeBranchRoles()); }
    function canStaffPay(c, b)        { return may(c, b, leadRoles().concat(['accountant'])); }
    function canStaffManage(c, b)     { return may(c, b, leadRoles()); }
    function canAttendanceView(c, b)  { return may(c, b, leadRoles().concat(['inCharge', 'supervisor'])); }
    function canAttendanceManage(c, b){ return may(c, b, leadRoles()); }
    function canKiosk(c, b)           { return may(c, b, leadRoles().concat(['inCharge', 'supervisor'])); }
    function canRecordsDelete(c, b)   { return may(c, b, leadRoles()); }
    function canPurchasesOrder(c, b)  { return may(c, b, leadRoles().concat(['inCharge', 'accountant', 'supervisor'])); }
    function canPurchasesApprove(c, b){ return may(c, b, leadRoles().concat(['inCharge'])); }
    function canPurchasesBills(c, b)  { return may(c, b, leadRoles().concat(['accountant'])); }
    function canBranchSettings(c, b)  { return may(c, b, leadRoles()); }
    function canMoneySettings(c, b) {
      let u = userData();
      return isAuth() && u.companyId == c && (
        u.role in ['owner', 'superAdmin', 'superadmin'] ||
        (isBranchAdmin(u) && inBranch(u, b))
      );
    }
    // who gets which notifications (4.3): company roles anywhere, a branch admin in their branch
    function canNotificationsManage(c, b) {
      let u = userData();
      return isAuth() && u.companyId == c && (u.role in companyRoles() || (isBranchAdmin(u) && inBranch(u, b)));
    }
    // ── issues (4.5, lib/issues/model.js) ──
    function canIssuesSeeAll(c, b) { return may(c, b, officeBranchRoles()); }
    function canIssuesManage(c, b) { return may(c, b, leadRoles().concat(['inCharge'])); }
    function isIssueParty(d) {
      return d.get('reporterUid', '') == request.auth.uid || d.get('assigneeUid', '') == request.auth.uid;
    }
    function canSeeIssue(c, b, d) {
      return canIssuesSeeAll(c, b) || (isBranchMember(c, b) && isIssueParty(d));
    }
    // ── tasks (4.11, lib/tasks/model.js) ──
    function canTasksManage(c, b) { return may(c, b, leadRoles().concat(['inCharge'])); }
    // a supervisor at this branch (their own team only)
    function canTasksTeam(c, b) {
      let u = userData();
      return isAuth() && u.companyId == c && inBranch(u, b) && u.role == 'supervisor';
    }
    // `uid` is staff at this branch whose record names me as supervisor, or names no one
    function inMyTeam(c, b, uid) {
      let u = get(/databases/$(database)/documents/users/$(uid)).data;
      return u.get('role', '') == 'staff' && u.get('branchId', '') == b && u.get('companyId', '') == c &&
        get(/databases/$(database)/documents/companies/$(c)/branches/$(b)/staff/$(u.get('staffId', 'none'))).data.get('supervisorUid', '') in [request.auth.uid, ''];
    }
    // who may see a task (and its thread): management, whoever has it, leads its team or gave it
    function canSeeTask(c, b, d) {
      return canTasksManage(c, b) || (isBranchMember(c, b) && (
        d.get('assigneeUid', '') == request.auth.uid || d.get('teamLeadUid', '') == request.auth.uid || d.get('creatorUid', '') == request.auth.uid));
    }
    // a one-off task marked done (or undone) by whoever has it: nothing else moves
    function isTaskWork() {
      return changedKeys().hasOnly(['status', 'done', 'updatedAt']) && request.resource.data.status in ['open', 'done'];
    }

    // the fields that move when work is done on an issue (not who it's for, not what it is)
    function isIssueWork() {
      return changedKeys().hasOnly(['status', 'resolution', 'resolvedBy', 'resolvedAt', 'updatedAt', 'lastActivityAt', 'watchers']);
    }

    // ── chat (4.4) ──
    function canChatGroups(c) { return mayInCompany(c, leadRoles()); }
    function canSeeChat(c, chat) {
      let u = userData();
      return u.companyId == c && (
        chat.kind == 'company' ||
        (chat.kind == 'branch' && (u.role in companyRoles() || u.get('branchId', null) == chat.get('branchId', ''))) ||
        ((chat.kind == 'group' || chat.kind == 'direct') && request.auth.uid in chat.get('members', [])));
    }
    function canSeeChatId(c, chatId) {
      return canSeeChat(c, get(/databases/$(database)/documents/companies/$(c)/chats/$(chatId)).data);
    }
    function sameCompany(uid, c) {
      return get(/databases/$(database)/documents/users/$(uid)).data.get('companyId', '') == c;
    }
    // The company chat, a branch's chat, a personal chat between two people of
    // the company, or a group made by management — each with its fixed id/shape.
    function isNewChat(c, chatId) {
      let d = request.resource.data;
      let u = userData();
      let m = d.get('members', []);
      return u.companyId == c && (
        (d.kind == 'company' && chatId == 'company') ||
        (d.kind == 'branch' && chatId == 'branch_' + d.branchId && canSeeChat(c, d)) ||
        (d.kind == 'direct' && m.size() == 2 && request.auth.uid in m && m[0] < m[1] &&
          chatId == 'dm_' + m[0] + '_' + m[1] && sameCompany(m[0], c) && sameCompany(m[1], c)) ||
        (d.kind == 'group' && canChatGroups(c) && request.auth.uid in m && d.createdBy == request.auth.uid)
      );
    }
    function canCatalogView(c)        { return mayInCompany(c, leadRoles().concat(['inCharge', 'accountant', 'supervisor'])); }
    function canCatalogManage(c)      { return mayInCompany(c, leadRoles().concat(['accountant'])); }
    function canBranchLoans(c)        { return mayInCompany(c, leadRoles().concat(['accountant'])); }
    function canPurchasesOrderAny(c)  { return mayInCompany(c, leadRoles().concat(['inCharge', 'accountant', 'supervisor'])); }
    function isOfficeMember(c)        { return mayInCompany(c, officeBranchRoles()); }

    // a purchase order change that approves, rejects or re-opens it (sending an
    // approved order, or an edit that clears its approval, is not)
    function isApprovalChange() {
      let before = resource.data.get('status', '');
      let after = request.resource.data.get('status', '');
      return (after != before && (after in ['Approved', 'Rejected'] || before == 'Rejected')) ||
        (changedKeys().hasAny(['approvedBy']) && request.resource.data.get('approvedBy', '') != '');
    }
    match /signupInvites/{code} {
      allow read: if true;
      allow create: if isPlatformAdmin();
      // Consume: flip used false→true. createdAt cannot change.
      allow update: if isAuth() &&
        resource.data.used == false &&
        request.resource.data.used == true &&
        request.resource.data.get('usedBy', '') == request.auth.uid &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['createdAt']);
      // Platform admins can clean up unused codes.
      allow delete: if isPlatformAdmin() && resource.data.used == false;
    }

    match /entitlements/{companyId} {
      allow read: if isPlatformAdmin() || belongsToCompany(companyId);
      allow write: if isPlatformAdmin();
    }

    // Username → email lookup: must be publicly readable so login by username works
    // before the user is authenticated with Firebase Auth
    // Staff log in with their phone or IC number (docs/STAFF_APP.md): the key is
    // a hash of the number, the doc only { uid, email }; written by the server.
    match /staffLogins/{key} {
      allow get: if true;
      allow list, write: if false;
    }

    match /usernames/{username} {
      allow read: if true;          // Public: required for username-based login
      // Your own login, or a company admin adding someone to their company.
      // (Anyone could claim any username before — including another user's.)
      allow create: if isAuth() && (
        request.resource.data.get('uid', '') == request.auth.uid ||
        isCompanyAdmin(request.resource.data.get('companyId', ''))
      );
      allow update, delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Global Users Collection
    // ─────────────────────────────────────────────────────────────────────────

    match /users/{uid} {
      // Users can only read their own document
      allow read: if isAuth() && request.auth.uid == uid;

      // Create when:
      //   - a company admin adds someone to their own company (never a platform admin)
      //   - a new owner signs up: their own record, as owner of a company that is
      //     being created in the same transaction (see the companies rule)
      // Before, any signed-in account could write itself into ANY company with
      // ANY role — e.g. owner of an existing company.
      allow create: if isAuth() &&
        request.resource.data.get('platformAdmin', false) == false && (
          isCompanyAdmin(request.resource.data.get('companyId', '')) ||
          (
            request.auth.uid == uid &&
            request.resource.data.get('role', '') == 'owner' &&
            !exists(/databases/$(database)/documents/companies/$(request.resource.data.get('companyId', ''))) &&
            getAfter(/databases/$(database)/documents/companies/$(request.resource.data.get('companyId', ''))).data.get('ownerUid', '') == uid
          )
        );

      allow delete: if false;

      // Users can update their own profile, but CANNOT change their role,
      // company, branch, or which staff record they are (staffId)
      allow update: if isAuth() &&
        request.auth.uid == uid &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['role', 'companyId', 'branchId', 'platformAdmin', 'staffId']);
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Companies Collection
    // ─────────────────────────────────────────────────────────────────────────

    match /companies/{companyId} {
      // Any member of this company can read the company document
      allow read: if belongsToCompany(companyId);

      // Sign-up creates a company: a brand-new account (no user record yet),
      // naming itself owner, using an unused invite consumed in the same
      // transaction. (The old rule checked the user record, which a transaction
      // cannot see yet — so sign-up was refused.)
      allow create: if isAuth() &&
        request.resource.data.get('ownerUid', '') == request.auth.uid &&
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('companyId', '') == companyId &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'owner' &&
        get(/databases/$(database)/documents/signupInvites/$(request.resource.data.get('inviteCode', '-'))).data.get('used', true) == false &&
        getAfter(/databases/$(database)/documents/signupInvites/$(request.resource.data.get('inviteCode', '-'))).data.get('usedBy', '') == request.auth.uid;

      // Only the owner can update/delete the company document
      allow update, delete: if isOwner(companyId);

      // ── Company Users Sub-collection ───────────────────────────────────────
      match /users/{uid} {
        allow read: if belongsToCompany(companyId);
        // A company admin, or a member updating their own entry (or the
        // owner's entry written during sign-up). Outsiders cannot add themselves.
        allow write: if isCompanyAdmin(companyId) ||
          (isAuth() && request.auth.uid == uid && (
            belongsToCompany(companyId) ||
            getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('companyId', '') == companyId
          ));

        // Individual users can manage their own device tokens
        match /fcmTokens/{token} {
          allow read, write: if isAuth() && request.auth.uid == uid;
        }

        // Their notifications (4.3): written only by the server (Cloud
        // Functions); the person reads them, marks them read, clears them.
        match /inbox/{id} {
          allow read, delete: if isAuth() && request.auth.uid == uid;
          allow update: if isAuth() && request.auth.uid == uid && changedKeys().hasOnly(['readAt']);
        }

        // Their own choices, e.g. kinds of notification they muted
        match /prefs/{doc} {
          allow read, write: if isAuth() && request.auth.uid == uid;
        }

        // Their own notes (4.11): no one else reads them, not even the owner
        match /notes/{noteId} {
          allow read, write: if isAuth() && request.auth.uid == uid && belongsToCompany(companyId);
        }
      }

      // ── Chat (roadmap 4.4, lib/chat/model.js) ──────────────────────────────
      // Company chat: everyone in the company. Branch chat: that branch's people
      // and the company roles. Groups (made by management) and personal chats:
      // their members. Your own message can be changed or deleted for 15 minutes.
      match /chats/{chatId} {
        allow get: if isAuth() && canSeeChat(companyId, resource.data);
        // listing: only the groups and personal chats you're in (members array-contains you)
        allow list: if belongsToCompany(companyId) && request.auth.uid in resource.data.members;
        allow create: if isAuth() && isNewChat(companyId, chatId);
        allow update: if isAuth() && canSeeChat(companyId, resource.data) && (
          // a new message moves the chat up the list
          changedKeys().hasOnly(['lastMessage', 'updatedAt']) ||
          // management renames a group or changes who is in it
          (resource.data.kind == 'group' && canChatGroups(companyId) &&
            changedKeys().hasOnly(['name', 'members', 'updatedAt']))
        );
        allow delete: if isAuth() && resource.data.kind == 'group' && canChatGroups(companyId) &&
          canSeeChat(companyId, resource.data);

        match /messages/{messageId} {
          allow read: if isAuth() && canSeeChatId(companyId, chatId);
          allow create: if isAuth() && canSeeChatId(companyId, chatId) &&
            request.resource.data.byUid == request.auth.uid &&
            request.resource.data.createdAt == request.time &&
            request.resource.data.get('deleted', false) == false;
          allow update: if isAuth() && (
            (resource.data.byUid == request.auth.uid &&
              resource.data.get('deleted', false) == false &&
              request.time < resource.data.createdAt + duration.value(15, 'm') &&
              changedKeys().hasOnly(['text', 'files', 'editedAt', 'deleted'])) ||
            // management removes any message for everyone in the company, branch and
            // group chats (never personal ones) — shown as "Removed by …"
            (canChatGroups(companyId) && canSeeChatId(companyId, chatId) &&
              get(/databases/$(database)/documents/companies/$(companyId)/chats/$(chatId)).data.kind != 'direct' &&
              resource.data.get('deleted', false) == false &&
              request.resource.data.deleted == true &&
              request.resource.data.removedBy.uid == request.auth.uid &&
              changedKeys().hasOnly(['text', 'files', 'editedAt', 'deleted', 'removedBy'])) ||
            // anyone in the chat reacts — changing only their own reaction
            (canSeeChatId(companyId, chatId) && changedKeys().hasOnly(['reactions']) &&
              request.resource.data.reactions.diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([request.auth.uid]))
          );
        }

        // when each person last looked
        match /reads/{uid} {
          allow read: if isAuth() && canSeeChatId(companyId, chatId);
          allow write: if isAuth() && request.auth.uid == uid && canSeeChatId(companyId, chatId);
        }
      }

      // The company's own chat stickers (4.4): everyone uses them; management adds and removes them.
      match /stickers/{stickerId} {
        allow read: if belongsToCompany(companyId);
        allow create: if canChatGroups(companyId) && request.resource.data.createdBy == request.auth.uid;
        allow delete: if canChatGroups(companyId);
      }

      // Who can be messaged: names and roles only, kept by the server from users/{uid}.
      match /chatPeople/{uid} {
        allow read: if belongsToCompany(companyId);
        allow write: if false;
      }

      // ── Notifications (Company Level) ──────────────────────────────────────
      match /notifications/{docId} {
        allow read: if belongsToCompany(companyId);
        // Old shared feed: read-only now — notifications are written by the
        // server to each person's inbox (4.3). Before, anyone could post here.
        allow create: if false;
        allow update: if belongsToCompany(companyId) && changedKeys().hasOnly(['read', 'readAt', 'updatedAt']);
        allow delete: if isOfficeMember(companyId);
      }

      // ── Staff Loans (Company Level) ────────────────────────────────────────
      match /loans/{docId} {
        // branch-to-branch loans
        allow read: if isOfficeMember(companyId);
        allow write: if canBranchLoans(companyId);
      }

      // ── Vendors ────────────────────────────────────────────────────────────
      // Company-wide settings. costCategories (roadmap 4.9, lib/costs/categories.js):
      // the cost groups and categories everyone picks from, kept by owner,
      // super admin and gm ("categories.manage").
      match /settings/{docId} {
        allow read: if belongsToCompany(companyId);
        allow write: if docId == 'costCategories' && mayInCompany(companyId, []);
      }

      match /vendors/{vendorId} {
        // pay-outs pick a supplier (4.10) — names, to choose from
        allow read: if canCatalogView(companyId) || canPayoutsAny(companyId);
        allow write: if canCatalogManage(companyId);
        // receiving goods raises what the vendor is owed
        allow update: if canPurchasesOrderAny(companyId) &&
          changedKeys().hasOnly(['currentBalance', 'totalBilled', 'updatedAt']);
        // a pay-out's supplier bill approved: what they're owed moves with it
        allow update: if canCostsApproveAny(companyId) &&
          changedKeys().hasOnly(['currentBalance', 'totalBilled', 'totalPaid', 'lastPaymentDate', 'updatedAt', 'lastPayout']) &&
          supplierPayoutApproved(companyId, request.resource.data.lastPayout.branchId, request.resource.data.lastPayout.settleId) &&
          getAfter(/databases/$(database)/documents/companies/$(companyId)/branches/$(request.resource.data.lastPayout.branchId)/payouts/$(request.resource.data.lastPayout.settleId)).data.supplier.vendorId == vendorId;
      }

      // ── POS: Customer DB (company-scoped so loyalty spans branches) ──────
      match /customers/{customerId} {
        allow read: if belongsToCompany(companyId);
        allow write: if isAuth() && userData().companyId == companyId && (
          userData().role == 'owner' ||
          isBranchAdmin(userData()) ||
          userData().role in ['manager', 'supervisor', 'cashier', 'accountant']
        );
      }

      // ── Items Catalog ──────────────────────────────────────────────────────
      // Cashier+ can read for POS recipe lookups; create/update by supervisor+.
      match /items/{itemId} {
        allow read: if canCatalogView(companyId);
        allow write: if canCatalogManage(companyId);
        // receiving goods records what the branch paid
        allow update: if canPurchasesOrderAny(companyId) &&
          changedKeys().hasOnly(['lastPurchaseByBranch', 'lastPurchasePrice', 'lastPurchaseDate', 'updatedAt']);
      }

      // ── Company Manual Deductions ──────────────────────────────────────────
      match /manual_deductions/{docId} {
        allow read: if isAuth() && userData().companyId == companyId &&
                       userData().role in ['owner', 'gm', 'superAdmin', 'superadmin'];
        allow write: if isAuth() && userData().companyId == companyId &&
                        userData().role in ['superAdmin', 'superadmin'];
      }

      // ── Audit Log (written by Cloud Functions only) ───────────────────────────
      // owner/gm/superAdmin: read all logs across the company
      // branchAdmin/manager: read only logs where branchId matches their assigned branch
      match /auditLog/{logId} {
        allow read: if isAuth() && userData().companyId == companyId && (
          userData().role in ['owner', 'gm', 'superAdmin'] ||
          (
            (isBranchAdmin(userData()) || userData().role == 'manager') &&
            resource.data.branchId == userData().branchId
          )
        );
        // Cloud Functions write their entries with the Admin SDK. The app adds
        // entries for actions it performs (approvals, pay-outs, edits) — always
        // in the signed-in user's own name; nobody edits or deletes entries.
        // (Before, every entry written from the app was silently refused.)
        allow create: if isAuth() && userData().companyId == companyId &&
          request.resource.data.get('userId', '') == request.auth.uid &&
          (isCompanyWide(userData()) || inBranch(userData(), request.resource.data.get('branchId', '')));
        allow update, delete: if false;
      }

      // ── Branches ───────────────────────────────────────────────────────────
      match /branches/{branchId} {
        // Any company member can read branch documents (metadata: name, id only).
        // Financial data lives in subcollections which keep their own canRead() rules.
        allow read: if belongsToCompany(companyId);

        // Only owner or branchAdmin can create/update branch metadata
        allow write: if canManageSettings(companyId, branchId);

        // ── Branch Settings ─────────────────────────────────────────────────
        match /settings/{docId} {   // Fixed typo from branchSettings to settings!
          allow read: if canRead(companyId, branchId);
          // settings/notifications has its own rule below — not for managers
          allow write: if docId != 'notifications' && canWriteBranchSettings(companyId, branchId);
        }

        // Who gets which notifications at this branch (4.3, lib/notify/model.js):
        // chosen by owner, super admin, gm or the branch admin.
        match /settings/notifications {
          allow read: if canRead(companyId, branchId);
          allow write: if canNotificationsManage(companyId, branchId);
        }

        // ── Branch Admins ─────────────────────────────────────────────────────
        // Only owner / superAdmin can assign/remove branch admins
        match /admins/{uid} {
          allow read: if belongsToCompany(companyId);
          allow write: if isCompanyAdmin(companyId);
        }

        // ── Branch Users ──────────────────────────────────────────────────────
        // Owner or branchAdmin of this branch can add/edit/remove users
        match /users/{uid} {
          allow read: if belongsToCompany(companyId);
          allow write: if canManageSettings(companyId, branchId);
        }

        // ── Monthly Summary Rollups ──────────────────────────────────────────
        // Written exclusively by Cloud Functions (Admin SDK bypasses these rules).
        // Any branch member can read — used by dashboards and reports.
        match /summaries/{month} {
          allow read: if canReportsView(companyId, branchId);
          allow write: if false;
        }

        // ── Sales ───────────────────────────────────────────────────────────
        match /sales/{docId} {
          allow read, create, update: if canSalesEnter(companyId, branchId);
          allow delete: if canRecordsDelete(companyId, branchId);
        }

        // ── Costs / Expenses ────────────────────────────────────────────────
        match /costs/{docId} {
          allow read: if canCostsEnter(companyId, branchId);
          // a new cost's voucher can only start out waiting
          allow create: if canCostsEnter(companyId, branchId) && (
            request.resource.data.get('voucher', {}).get('status', 'pending') == 'pending' ||
            // a pay-out's bill approved with no paper: its voucher was decided with it (4.10)
            (request.resource.data.get('meta', {}).get('type', '') == 'payout' && canCostsApprove(companyId, branchId))
          );
          // A voucher (a cost with no invoice, 4.9) is decided by branch admin,
          // manager or in-charge (and the company roles) — never by whoever made it.
          allow update: if canCostsEnter(companyId, branchId) && (
            !voucherDecided() || (canCostsApprove(companyId, branchId) && voucherMaker() != request.auth.uid)
          );
          allow delete: if canRecordsDelete(companyId, branchId);
        }

        // ── Pay-outs and their bills (4.10, lib/payouts/model.js) ─────────────
        // kind "out": money handed out of the till; kind "settle": the bill
        // back. Till roles hand out and bring bills back; branch admin,
        // manager or in-charge (and the company roles) approve or send a bill
        // back — never one they handed out or brought back. Approved bills
        // become costs and are not changed here again.
        match /payouts/{docId} {
          allow read: if canPayoutsHandOut(companyId, branchId) || canCostsApprove(companyId, branchId) || canReportsView(companyId, branchId);
          allow create: if canPayoutsHandOut(companyId, branchId) &&
            request.resource.data.by.uid == request.auth.uid && (
              (request.resource.data.kind == 'out' && request.resource.data.status == 'open') ||
              (request.resource.data.kind == 'settle' && request.resource.data.status == 'pending')
            );
          allow update: if resource.data.get('status', '') != 'approved' && (
            // an open pay-out gets its bill
            (resource.data.kind == 'out' && canPayoutsHandOut(companyId, branchId) &&
              changedKeys().hasOnly(['status', 'settleId', 'updatedAt']) && request.resource.data.status == 'billed') ||
            // a bill sent back is tried again
            (resource.data.kind == 'settle' && resource.data.status == 'rejected' && canPayoutsHandOut(companyId, branchId) &&
              request.resource.data.status == 'pending' && request.resource.data.by.uid == request.auth.uid &&
              !changedKeys().hasAny(['kind', 'payoutId', 'floatAmount', 'payoutBy'])) ||
            // approved or sent back by someone in charge, not their own
            (resource.data.kind == 'settle' && resource.data.status == 'pending' && canCostsApprove(companyId, branchId) &&
              request.resource.data.status in ['approved', 'rejected'] &&
              resource.data.by.uid != request.auth.uid &&
              resource.data.get('payoutBy', {}).get('uid', '') != request.auth.uid &&
              !changedKeys().hasAny(['kind', 'payoutId', 'floatAmount', 'by', 'payoutBy', 'date']))
          );
          // a pay-out made by mistake, before any bill: whoever made it; anything else: those who delete records
          allow delete: if canRecordsDelete(companyId, branchId) ||
            (resource.data.kind == 'out' && resource.data.status == 'open' && resource.data.by.uid == request.auth.uid);
        }

        // ── Bank Deposits ────────────────────────────────────────────────────
        match /deposits/{docId} {
          allow read: if canCashBank(companyId, branchId) || canReportsView(companyId, branchId);
          allow create, update: if canCashBank(companyId, branchId);
          allow delete: if canRecordsDelete(companyId, branchId);
        }

        // ── Cash Withdrawals ─────────────────────────────────────────────────
        match /cashWithdrawals/{docId} {
          allow read: if canCashBank(companyId, branchId) || canReportsView(companyId, branchId);
          allow create, update: if canCashBank(companyId, branchId);
          allow delete: if canRecordsDelete(companyId, branchId);
        }

        // ── Staff List ───────────────────────────────────────────────────────
        // Owner can manage staff in any branch; branchAdmin/manager only in their own.
        match /staff/{docId} {
          allow read: if canStaffView(companyId, branchId) ||
            (isBranchMember(companyId, branchId) && resource.data.get('uid', '') == request.auth.uid);
          allow write: if canStaffManage(companyId, branchId);
          // The person themselves, from the staff app's settings (docs/STAFF_APP.md):
          // their contact number and photo only — never name, job, pay or PINs.
          allow update: if isBranchMember(companyId, branchId) &&
            resource.data.get('uid', '') == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phone', 'photoUrl', 'updatedAt']);
        }

        // Pay, IC, bank and personal details, apart from the staff record
        // (lib/staffPrivate.js): those who may see pay, and the person themselves.
        match /staffPrivate/{staffId} {
          allow read: if canStaffPay(companyId, branchId) ||
            (isBranchMember(companyId, branchId) && userData().get('staffId', '') == staffId);
          allow write: if canStaffManage(companyId, branchId);
          // The person themselves: their emergency contact only.
          allow create: if isBranchMember(companyId, branchId) && userData().get('staffId', '') == staffId &&
            request.resource.data.keys().hasOnly(['emergencyContactName', 'emergencyContactPhone', 'updatedAt']);
          allow update: if isBranchMember(companyId, branchId) && userData().get('staffId', '') == staffId &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['emergencyContactName', 'emergencyContactPhone', 'updatedAt']);

          // Each person's own copy of their payslips (lib/payroll/payslipCopy.js),
          // written when payroll is finalized or paid, removed when reverted —
          // so staff see their slips without seeing the run's totals.
          match /payslips/{runId} {
            allow read: if canPayrollView(companyId, branchId) ||
              (isBranchMember(companyId, branchId) && userData().get('staffId', '') == staffId);
            allow write: if canPayrollManage(companyId, branchId);
          }
        }

        // ── Salaries ─────────────────────────────────────────────────────────
        match /salaries/{docId} {
          // Salary payments are entries in the cash book: those who see the
          // reports read them (the figures need them). Pay rates, bank and ID
          // stay in staffPrivate; payslips in payrollRuns.
          allow read: if canSalariesEnter(companyId, branchId) || canReportsView(companyId, branchId);
          allow create, update: if canSalariesEnter(companyId, branchId);
          allow delete: if canRecordsDelete(companyId, branchId);
        }

        // ── Staff Loans (Branch Level) ───────────────────────────────────────
        match /loans/{docId} {
          // Anyone at the branch may ASK (pending, unpaid) and cancel their own while
          // it waits. branchAdmin / manager (and company roles) approve or reject —
          // one approval is enough — or record one handed over on the spot.
          // A payer (cashier and up) marks an approved one paid — once, changing
          // nothing else. Payroll instalments: whoever enters salaries. Staff read
          // only their own (isOwnRequest).
          allow read: if canAdvancesPayOut(companyId, branchId) || canReportsView(companyId, branchId) ||
            (isBranchMember(companyId, branchId) && isOwnRequest());
          allow create: if canAdvancesApprove(companyId, branchId) ||
            (isBranchMember(companyId, branchId) && isNewRequest());
          allow update: if canAdvancesApprove(companyId, branchId) ||
            (canAdvancesPayOut(companyId, branchId) && isPayOut()) ||
            (canSalariesEnter(companyId, branchId) && isBookkeeping()) ||
            (isBranchMember(companyId, branchId) && isOwnRequest() && isCancel());
          allow delete: if canAdvancesApprove(companyId, branchId);
        }

        // ── Issues (roadmap 4.5) ────────────────────────────────────────────
        // Everyone at the branch raises them; office roles see the branch's,
        // staff the ones they raised or were given. Management (and in-charge)
        // assign, close, reopen and delete; the assignee starts and resolves;
        // the reporter reopens a resolved one.
        match /issues/{issueId} {
          allow get: if canSeeIssue(companyId, branchId, resource.data);
          allow list: if canIssuesSeeAll(companyId, branchId) ||
            (isBranchMember(companyId, branchId) &&
              (resource.data.reporterUid == request.auth.uid || resource.data.assigneeUid == request.auth.uid));
          allow create: if isBranchMember(companyId, branchId) &&
            request.resource.data.reporterUid == request.auth.uid &&
            (canIssuesManage(companyId, branchId) ||
              (request.resource.data.status == 'open' && request.resource.data.get('assigneeUid', null) == null));
          allow update: if canIssuesManage(companyId, branchId) ||
            (resource.data.get('assigneeUid', '') == request.auth.uid && isIssueWork() &&
              request.resource.data.status in ['in_progress', 'resolved']) ||
            (resource.data.reporterUid == request.auth.uid && resource.data.status == 'resolved' &&
              request.resource.data.status == 'open' && isIssueWork()) ||
            (canSeeIssue(companyId, branchId, resource.data) &&
              changedKeys().hasOnly(['lastActivityAt', 'watchers', 'updatedAt']));
          allow delete: if canIssuesManage(companyId, branchId);

          // its discussion: whoever can see the issue reads and writes, as themselves
          match /comments/{commentId} {
            allow read: if canSeeIssue(companyId, branchId,
              get(/databases/$(database)/documents/companies/$(companyId)/branches/$(branchId)/issues/$(issueId)).data);
            allow create: if canSeeIssue(companyId, branchId,
                get(/databases/$(database)/documents/companies/$(companyId)/branches/$(branchId)/issues/$(issueId)).data) &&
              request.resource.data.byUid == request.auth.uid &&
              request.resource.data.createdAt == request.time;
          }
        }

        // ── Tasks and checklists (roadmap 4.11) ─────────────────────────────
        // Management gives, changes and stops them; whoever has one sees it and
        // marks it done. Each tick of a repeating one is a taskCheck.
        match /tasks/{taskId} {
          allow read: if canSeeTask(companyId, branchId, resource.data);
          // management gives anyone a task; a supervisor gives their team one, leading it
          allow create: if canTasksManage(companyId, branchId) ||
            (canTasksTeam(companyId, branchId) &&
              request.resource.data.creatorUid == request.auth.uid &&
              request.resource.data.teamLeadUid == request.auth.uid &&
              inMyTeam(companyId, branchId, request.resource.data.assigneeUid));
          allow update: if canTasksManage(companyId, branchId) ||
            // whoever has a one-off marks it done (or not)
            (isBranchMember(companyId, branchId) && resource.data.get('assigneeUid', '') == request.auth.uid &&
              resource.data.get('repeat', null) == null && isTaskWork()) ||
            // a supervisor changes the tasks they lead, still within their team
            (canTasksTeam(companyId, branchId) && resource.data.get('teamLeadUid', '') == request.auth.uid &&
              request.resource.data.teamLeadUid == request.auth.uid &&
              !changedKeys().hasAny(['creatorUid', 'createdBy']) &&
              inMyTeam(companyId, branchId, request.resource.data.assigneeUid)) ||
            // a supervisor hands a task given to them on to their team
            (canTasksTeam(companyId, branchId) && resource.data.get('assigneeUid', '') == request.auth.uid &&
              changedKeys().hasOnly(['assignee', 'assigneeUid', 'teamLeadUid', 'via', 'updatedAt']) &&
              request.resource.data.teamLeadUid == request.auth.uid &&
              inMyTeam(companyId, branchId, request.resource.data.assigneeUid)) ||
            // a new question or answer: whoever can see it counts it up by one, as themselves
            (canSeeTask(companyId, branchId, resource.data) &&
              changedKeys().hasOnly(['commentCount', 'lastCommentAt', 'lastCommentByUid']) &&
              request.resource.data.commentCount == resource.data.get('commentCount', 0) + 1 &&
              request.resource.data.lastCommentAt == request.time &&
              request.resource.data.lastCommentByUid == request.auth.uid);
          allow delete: if canTasksManage(companyId, branchId) ||
            (canTasksTeam(companyId, branchId) && resource.data.get('creatorUid', '') == request.auth.uid &&
              resource.data.get('teamLeadUid', '') == request.auth.uid);

          // questions and answers about the task: whoever can see it, as themselves
          match /comments/{commentId} {
            allow read: if canSeeTask(companyId, branchId,
              get(/databases/$(database)/documents/companies/$(companyId)/branches/$(branchId)/tasks/$(taskId)).data);
            allow create: if canSeeTask(companyId, branchId,
                get(/databases/$(database)/documents/companies/$(companyId)/branches/$(branchId)/tasks/$(taskId)).data) &&
              request.resource.data.byUid == request.auth.uid &&
              request.resource.data.createdAt == request.time;
          }
        }
        match /taskChecks/{checkId} {
          allow read: if canTasksManage(companyId, branchId) ||
            (isBranchMember(companyId, branchId) && (
              resource.data.get('assigneeUid', '') == request.auth.uid || resource.data.get('teamLeadUid', '') == request.auth.uid));
          // ticked as yourself, under the id {taskId}_{date}, for a task that is yours —
          // or for someone, by management or the supervisor leading it; the tick
          // carries the task's team lead
          allow create: if isBranchMember(companyId, branchId) &&
            request.resource.data.by.uid == request.auth.uid &&
            checkId == request.resource.data.taskId + '_' + request.resource.data.date &&
            get(/databases/$(database)/documents/companies/$(companyId)/branches/$(branchId)/tasks/$(request.resource.data.taskId)).data.get('assigneeUid', '') == request.resource.data.assigneeUid &&
            get(/databases/$(database)/documents/companies/$(companyId)/branches/$(branchId)/tasks/$(request.resource.data.taskId)).data.get('teamLeadUid', null) == request.resource.data.get('teamLeadUid', null) &&
            (request.resource.data.assigneeUid == request.auth.uid || canTasksManage(companyId, branchId) ||
              (canTasksTeam(companyId, branchId) && request.resource.data.get('teamLeadUid', '') == request.auth.uid));
          // a new supervisor leads the task: management moves its ticks along
          allow update: if canTasksManage(companyId, branchId) && changedKeys().hasOnly(['teamLeadUid']);
          // untick: whoever ticked it, the team's supervisor, or management
          allow delete: if canTasksManage(companyId, branchId) ||
            (isBranchMember(companyId, branchId) && (
              resource.data.get('by', {}).get('uid', '') == request.auth.uid || resource.data.get('teamLeadUid', '') == request.auth.uid));
        }
        // A manager's stars for someone's month: management writes (never their
        // own); the person sees their own.
        match /ratings/{ratingId} {
          allow read: if canTasksManage(companyId, branchId) ||
            (isBranchMember(companyId, branchId) && resource.data.get('uid', '') == request.auth.uid);
          allow create, update: if canTasksManage(companyId, branchId) &&
            request.resource.data.uid != request.auth.uid &&
            request.resource.data.by.uid == request.auth.uid &&
            ratingId == request.resource.data.month + '_' + request.resource.data.uid &&
            request.resource.data.stars is int && request.resource.data.stars >= 1 && request.resource.data.stars <= 5;
          allow delete: if canTasksManage(companyId, branchId);
        }

        // ── Leave requests (roadmap 4.2) ────────────────────────────────────
        match /leaves/{docId} {
          // Anyone at the branch may ask and cancel their own while it waits;
          // approvers decide. Those who plan shifts and pay see them all.
          allow read: if canAdvancesApprove(companyId, branchId) || canAttendanceView(companyId, branchId) ||
            canPayrollView(companyId, branchId) ||
            (isBranchMember(companyId, branchId) && isOwnRequest());
          allow create: if canAdvancesApprove(companyId, branchId) ||
            (isBranchMember(companyId, branchId) && isNewRequest());
          allow update: if canAdvancesApprove(companyId, branchId) ||
            (isBranchMember(companyId, branchId) && isOwnRequest() && isCancel());
          allow delete: if canAdvancesApprove(companyId, branchId);
        }

        // ── Staff Advances ───────────────────────────────────────────────────
        match /advances/{docId} {
          // Anyone at the branch may ASK (pending, unpaid) and cancel their own while
          // it waits. branchAdmin / manager (and company roles) approve or reject —
          // one approval is enough — or record one handed over on the spot.
          // A payer (cashier and up) marks an approved one paid — once, changing
          // nothing else. Payroll instalments: whoever enters salaries. Staff read
          // only their own (isOwnRequest).
          allow read: if canAdvancesPayOut(companyId, branchId) || canReportsView(companyId, branchId) ||
            (isBranchMember(companyId, branchId) && isOwnRequest());
          allow create: if canAdvancesApprove(companyId, branchId) ||
            (isBranchMember(companyId, branchId) && isNewRequest());
          allow update: if canAdvancesApprove(companyId, branchId) ||
            (canAdvancesPayOut(companyId, branchId) && isPayOut()) ||
            (canSalariesEnter(companyId, branchId) && isBookkeeping()) ||
            (isBranchMember(companyId, branchId) && isOwnRequest() && isCancel());
          allow delete: if canAdvancesApprove(companyId, branchId);
        }

        // ── Old branch chat — read-only; chat moved to companies/{c}/chats (4.4,
        // `npm run chat:migrate` copies these across) ────────────────────────
        match /chat_messages/{messageId} {
          allow read: if isBranchMember(companyId, branchId);
          allow write: if false;
        }

        // ── Attendance (Shared Kiosk) ────────────────────────────────────────
        match /attendance/{docId} {
          allow read: if canAttendanceView(companyId, branchId) || canPayrollManage(companyId, branchId) ||
            (isBranchMember(companyId, branchId) && isOwnStaffRecord());
          allow write: if canKiosk(companyId, branchId);
        }

        // ── Early-OT Requests (shift templates) ──────────────────────────────
        // Raised by the kiosk on an early punch-in, approved in the Requested
        // Panel. Same access shape as attendance.
        match /otRequests/{docId} {
          allow read: if canAttendanceView(companyId, branchId) || canPayrollManage(companyId, branchId) ||
            (isBranchMember(companyId, branchId) && isOwnStaffRecord());
          allow write: if canKiosk(companyId, branchId);
        }

        // ── Vendor Bills ─────────────────────────────────────────────────────
        match /vendorBills/{docId} {
          // those who hand out pay-outs see what suppliers are owed, to pick a bill (4.10)
          allow read: if canPurchasesBills(companyId, branchId) || canPayoutsHandOut(companyId, branchId) || canCostsApprove(companyId, branchId);
          allow update, delete: if canPurchasesBills(companyId, branchId);
          // receiving goods against a purchase order raises the bill
          allow create: if canPurchasesBills(companyId, branchId) || canPurchasesOrder(companyId, branchId);
          // a pay-out's supplier bill approved: the bill it paid, or the bill it raised
          allow update: if canCostsApprove(companyId, branchId) &&
            changedKeys().hasOnly(['paid', 'balance', 'status', 'updatedAt', 'paymentHistory', 'lastPayoutSettleId']) &&
            supplierPayoutApproved(companyId, branchId, request.resource.data.lastPayoutSettleId);
          allow create: if canCostsApprove(companyId, branchId) &&
            supplierPayoutApproved(companyId, branchId, request.resource.data.payoutSettleId);
        }

        // ── Vendor Payments ──────────────────────────────────────────────────
        match /vendorPayments/{docId} {
          allow read, write: if canPurchasesBills(companyId, branchId);
          // the payment a pay-out made to a supplier, written as its bill is approved
          allow create: if canCostsApprove(companyId, branchId) &&
            supplierPayoutApproved(companyId, branchId, request.resource.data.payoutSettleId);
        }

        // ── Purchase Requisitions ────────────────────────────────────────────
        match /requisitions/{docId} {
          allow read, create, delete: if canPurchasesOrder(companyId, branchId);
          allow update: if canPurchasesApprove(companyId, branchId) ||
            (canPurchasesOrder(companyId, branchId) && !isApprovalChange());
        }

        // ── Document number counters (PO numbers, etc.) ───────────────────────
        // One document per series, holding one field per YYMM period. Anyone
        // allowed to raise the underlying document must be able to draw a
        // number, so this mirrors the requisitions write rule.
        match /counters/{seriesId} {
          allow read, write: if canPurchasesOrder(companyId, branchId);
        }

        // ── POS: Order Guides ────────────────────────────────────────────────
        match /orderGuides/{docId} {
          allow read, write: if canPurchasesOrder(companyId, branchId);
        }

        // ── Payroll Runs ──────────────────────────────────────────────────────
        // branchAdmin / manager: full read+write on runs and slips for their branch
        match /payrollRuns/{runId} {
          allow read: if canPayrollView(companyId, branchId);
          allow write: if canPayrollManage(companyId, branchId);

          match /slips/{slipId} {
            allow read: if canPayrollView(companyId, branchId);
            allow write: if canPayrollManage(companyId, branchId);
          }
        }

        // ── POS subtree ──────────────────────────────────────────────────────
        // Everything the till owns lives under one document, branches/{b}/pos/main.
        // Keeping it here rather than beside the finance collections means the POS
        // can never write a document v2 reads by the same name — `staff`,
        // `deposits` and `cashWithdrawals` all exist in both apps meaning
        // different things.
        //
        // The connection document is the on/off switch, so only someone who can
        // manage branch settings may create or flip it. What lives beneath it
        // splits two ways: things a cashier does during service, and things that
        // configure the branch.
        match /pos/{posDoc} {
          allow read: if canRead(companyId, branchId);
          allow create, update: if canManageSettings(companyId, branchId);
          // Disconnecting is a flag, never a delete — orders and shifts under
          // here are financial records.
          allow delete: if false;

          // Service-time records: any till operator may write them.
          match /orders/{docId} {
            allow read: if canRead(companyId, branchId);
            allow create, update: if canOperatePos(companyId, branchId);
            allow delete: if false;
          }
          match /shifts/{docId} {
            allow read: if canRead(companyId, branchId);
            allow create, update: if canOperatePos(companyId, branchId);
            allow delete: if false;
          }
          match /deposits/{docId} {
            allow read: if canRead(companyId, branchId);
            allow create, update: if canOperatePos(companyId, branchId);
            allow delete: if false;
          }
          match /cashWithdrawals/{docId} {
            allow read: if canRead(companyId, branchId);
            allow create, update: if canOperatePos(companyId, branchId);
            allow delete: if false;
          }
          match /reservations/{docId} {
            allow read: if canRead(companyId, branchId);
            allow write: if canOperatePos(companyId, branchId);
          }
          match /terminals/{docId} {
            allow read: if canRead(companyId, branchId);
            allow write: if canOperatePos(companyId, branchId);
          }
          match /stockCounts/{docId} {
            allow read: if canRead(companyId, branchId);
            allow write: if canOperatePos(companyId, branchId);
          }
          // A cashier seats and clears tables; only a manager reshapes the room.
          match /tables/{docId} {
            allow read: if canRead(companyId, branchId);
            allow update: if canOperatePos(companyId, branchId);
            allow create, delete: if canConfigurePos(companyId, branchId);
          }

          // Configuration: manager and above.
          match /menu/{docId} {
            allow read: if canRead(companyId, branchId);
            allow write: if canConfigurePos(companyId, branchId);
          }
          match /categories/{docId} {
            allow read: if canRead(companyId, branchId);
            allow write: if canConfigurePos(companyId, branchId);
          }
          match /modifierGroups/{docId} {
            allow read: if canRead(companyId, branchId);
            allow write: if canConfigurePos(companyId, branchId);
          }
          match /combos/{docId} {
            allow read: if canRead(companyId, branchId);
            allow write: if canConfigurePos(companyId, branchId);
          }
          match /promotions/{docId} {
            allow read: if canRead(companyId, branchId);
            allow write: if canConfigurePos(companyId, branchId);
          }
          match /floors/{docId} {
            allow read: if canRead(companyId, branchId);
            allow write: if canConfigurePos(companyId, branchId);
          }

          // Till logins. Readable by the terminal because the PIN screen has to
          // look one up — which is exactly why these records hold nothing but a
          // username, a PIN and a POS role. v2's `staff` collection, with its
          // passport numbers and salaries, stays out of the till's reach.
          match /tillUsers/{docId} {
            allow read: if canRead(companyId, branchId);
            allow write: if canConfigurePos(companyId, branchId);
          }
        }

        // ── POS: Categories (menu groups) ────────────────────────────────────
        match /categories/{docId} {
          allow read: if canRead(companyId, branchId);
          allow write: if canWrite(companyId, branchId);
        }

        // ── POS: Menu items ──────────────────────────────────────────────────
        match /menu/{docId} {
          allow read: if canRead(companyId, branchId);
          allow write: if canWrite(companyId, branchId);
        }

        // ── POS: Modifier groups (size, add-ons, etc.) ───────────────────────
        match /modifierGroups/{docId} {
          allow read: if canRead(companyId, branchId);
          allow write: if canWrite(companyId, branchId);
        }

        // ── POS: Orders (tickets) ────────────────────────────────────────────
        // Cashiers and above can create/update orders; only owner/branchAdmin can void/refund.
        match /orders/{docId} {
          allow read: if canRead(companyId, branchId);
          allow create, update: if isAuth() && userData().companyId == companyId && (
            userData().role == 'owner' ||
            (
              (isBranchAdmin(userData()) || userData().role in ['manager', 'supervisor', 'cashier', 'accountant']) &&
              inBranch(userData(), branchId)
            )
          );
          allow delete: if false;
        }

        // ── POS: Shifts (open/close, salesTotal accumulator) ─────────────────
        // Cashiers can open/close their own shift; manager+ can update any.
        match /shifts/{docId} {
          allow read: if canRead(companyId, branchId);
          allow write: if isAuth() && userData().companyId == companyId && (
            userData().role == 'owner' ||
            (
              (isBranchAdmin(userData()) || userData().role in ['manager', 'supervisor', 'cashier', 'accountant']) &&
              inBranch(userData(), branchId)
            )
          );
        }

        // ── POS: Registered terminals ────────────────────────────────────────
        match /terminals/{docId} {
          allow read: if canRead(companyId, branchId);
          allow write: if canWrite(companyId, branchId);
        }

        // ── POS: Floors (sections/zones in the restaurant) ───────────────────
        match /floors/{docId} {
          allow read: if canRead(companyId, branchId);
          allow write: if canWrite(companyId, branchId);
        }

        // ── POS: Promotions (auto-applied at cart) ───────────────────────────
        match /promotions/{docId} {
          allow read: if canRead(companyId, branchId);
          allow write: if canWrite(companyId, branchId);
        }

        // ── POS: Combos / set meals ──────────────────────────────────────────
        match /combos/{docId} {
          allow read: if canRead(companyId, branchId);
          allow write: if canWrite(companyId, branchId);
        }

        // ── POS: Ingredients (legacy — superseded by items + itemStock) ──────
        match /ingredients/{docId} {
          allow read: if canRead(companyId, branchId);
          allow write: if canWrite(companyId, branchId);
        }

        // ── POS: Per-branch stock for company-wide items (replaces ingredients).
        // Updated transactionally by inventoryMovements writers.
        match /itemStock/{itemId} {
          allow read: if canRead(companyId, branchId);
          allow write: if isAuth() && userData().companyId == companyId && (
            userData().role == 'owner' ||
            isBranchAdmin(userData()) ||
            userData().role in ['manager', 'supervisor', 'cashier', 'accountant']
          );
        }

        // ── POS: Inventory ledger (append-only; updated via transactions) ────
        // Reads open to branch staff; writes restricted to cashier+ (so POS
        // can record SALE_CONSUMPTION). Deletes never allowed.
        match /inventoryMovements/{docId} {
          allow read: if canRead(companyId, branchId);
          allow create, update: if isAuth() && userData().companyId == companyId && (
            userData().role == 'owner' ||
            isBranchAdmin(userData()) ||
            userData().role in ['manager', 'supervisor', 'cashier', 'accountant']
          );
          allow delete: if false;
        }

        // ── POS: Stock count sessions ────────────────────────────────────────
        match /stockCounts/{docId} {
          allow read: if canRead(companyId, branchId);
          allow write: if canWrite(companyId, branchId);
        }

        // ── POS: Reservations / waitlist ─────────────────────────────────────
        match /reservations/{docId} {
          allow read: if canRead(companyId, branchId);
          allow write: if isAuth() && userData().companyId == companyId && (
            userData().role == 'owner' ||
            isBranchAdmin(userData()) ||
            userData().role in ['manager', 'supervisor', 'cashier']
          );
        }

        // ── POS: Tables (physical tables on a floor) ─────────────────────────
        // Cashiers can update table.status (when seating/clearing); only
        // owner/branchAdmin can create/delete or reshape the layout.
        match /tables/{docId} {
          allow read: if canRead(companyId, branchId);
          allow create, delete: if canManageSettings(companyId, branchId);
          allow update: if canManageSettings(companyId, branchId) || (
            isAuth() && userData().companyId == companyId &&
            userData().role in ['cashier', 'supervisor', 'manager', 'accountant'] &&
            inBranch(userData(), branchId)
          );
        }

        // ── Work Media: Wall Posts ───────────────────────────────────────────
        match /wall_posts/{postId} {
          allow read, write: if isBranchMember(companyId, branchId);

          match /comments/{commentId} {
            allow read, write: if isBranchMember(companyId, branchId);
          }
        }
      }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Deny all other paths not matched above
    // ─────────────────────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
