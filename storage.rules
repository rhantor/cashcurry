rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ─────────────────────────────────────────────────────────────────────────
    // Helper Functions
    // ─────────────────────────────────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    function userData() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    // Handles both legacy lowercase "branchadmin" and canonical "branchAdmin"
    function isBranchAdmin(u) {
      return u.role == 'branchAdmin' || u.role == 'branchadmin';
    }

    // Company-level roles sit above branches and reach every branch's files.
    // Mirrors canRead/canWrite in firestore.rules. Legacy all-lowercase
    // 'superadmin' is accepted for pre-existing user docs.
    function isCompanyRole(u) {
      return u.role in ['owner', 'gm', 'superAdmin', 'superadmin'];
    }

    // Can the user open this branch's files (receipts, salary sheets, bills…)?
    // Company roles, or the branch's own users — not staff (these are finance
    // documents; firestore.rules canRead draws the same line).
    function canAccessBranch(companyId, branchId) {
      let u = userData();
      return isAuth() && u.companyId == companyId && (
        isCompanyRole(u) ||
        (u.get('branchId', null) == branchId && u.role != 'staff')
      );
    }

    // Anyone who works at the branch, staff included (staff photos).
    function isBranchMember(companyId, branchId) {
      let u = userData();
      return isAuth() && u.companyId == companyId && (
        isCompanyRole(u) || u.get('branchId', null) == branchId
      );
    }

    // Can the user upload? Company-level roles, or writer roles on their
    // assigned branch.
    function canUpload(companyId, branchId) {
      let u = userData();
      return isAuth() && u.companyId == companyId && (
        isCompanyRole(u) ||
        (u.get('branchId', null) == branchId &&
          (isBranchAdmin(u) || u.role in ['manager', 'inCharge', 'accountant', 'supervisor']))
      );
    }

    // Can the user delete? Owner or branchAdmin only.
    function canDelete(companyId, branchId) {
      let u = userData();
      return isAuth() && u.companyId == companyId && (
        u.role == 'owner' ||
        (u.get('branchId', null) == branchId && isBranchAdmin(u))
      );
    }

    // Company-level access (not tied to a specific branch)
    function belongsToCompany(companyId) {
      let u = userData();
      return isAuth() && u.companyId == companyId;
    }

    function canWriteCompanyLevel(companyId) {
      let u = userData();
      return isAuth() && u.companyId == companyId && (
        u.role == 'owner' ||
        isBranchAdmin(u) ||
        u.role in ['manager', 'accountant', 'supervisor']
      );
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Sales Z-Report Images: zReports/{companyId}/{branchId}/{filename}
    // ─────────────────────────────────────────────────────────────────────────
    match /zReports/{companyId}/{branchId}/{filename} {
      allow read: if canAccessBranch(companyId, branchId);
      allow create, update: if canUpload(companyId, branchId) &&
        request.resource.size <= 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if canDelete(companyId, branchId);
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Cost Entry Files: costs/{companyId}/{branchId}/...
    // Multi-segment wildcard because path includes category/office sub-folders
    // ─────────────────────────────────────────────────────────────────────────
    match /costs/{companyId}/{branchId}/{rest=**} {
      allow read: if canAccessBranch(companyId, branchId);
      allow create, update: if canUpload(companyId, branchId) &&
        request.resource.size <= 10 * 1024 * 1024;
      allow delete: if canDelete(companyId, branchId);
    }

    // Pay-out bills (4.10): photos of the bill brought back, each person into
    // their own folder: payouts/{companyId}/{branchId}/{uid}/{filename}.
    // Till roles bring them; the branch's office reads them.
    match /payouts/{companyId}/{branchId}/{uid}/{filename} {
      allow read: if canAccessBranch(companyId, branchId);
      allow create: if canAccessBranch(companyId, branchId) && request.auth.uid == uid &&
        userData().role in ['owner', 'superAdmin', 'superadmin', 'gm', 'branchAdmin', 'branchadmin', 'manager', 'inCharge', 'supervisor', 'cashier'] &&
        request.resource.size <= 10 * 1024 * 1024 &&
        (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
      allow delete: if canDelete(companyId, branchId);
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Deposit Entry Receipts: deposits/{companyId}/{branchId}/{filename}
    // ─────────────────────────────────────────────────────────────────────────
    match /deposits/{companyId}/{branchId}/{filename} {
      allow read: if canAccessBranch(companyId, branchId);
      allow create, update: if canUpload(companyId, branchId) &&
        request.resource.size <= 10 * 1024 * 1024;
      allow delete: if canDelete(companyId, branchId);
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Cash Withdrawal Receipts: withdrawReceipts/{companyId}/{branchId}/{filename}
    // ─────────────────────────────────────────────────────────────────────────
    match /withdrawReceipts/{companyId}/{branchId}/{filename} {
      allow read: if canAccessBranch(companyId, branchId);
      allow create, update: if canUpload(companyId, branchId) &&
        request.resource.size <= 10 * 1024 * 1024;
      allow delete: if canDelete(companyId, branchId);
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Salary Sheets: salarySheets/{companyId}/{branchId}/{filename}
    // ─────────────────────────────────────────────────────────────────────────
    match /salarySheets/{companyId}/{branchId}/{filename} {
      allow read: if canAccessBranch(companyId, branchId);
      allow create, update: if canUpload(companyId, branchId) &&
        request.resource.size <= 10 * 1024 * 1024;
      allow delete: if canDelete(companyId, branchId);
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Salary PDFs (generated reports): salaryPDFs/{companyId}/{branchId}/{filename}
    // ─────────────────────────────────────────────────────────────────────────
    match /salaryPDFs/{companyId}/{branchId}/{filename} {
      allow read: if canAccessBranch(companyId, branchId);
      allow create, update: if canUpload(companyId, branchId) &&
        request.resource.size <= 10 * 1024 * 1024 &&
        request.resource.contentType == 'application/pdf';
      allow delete: if canDelete(companyId, branchId);
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Vendor Bills / Invoices: bills/{companyId}/{branchId}/...
    // Multi-segment because path includes vendorId sub-folder
    // ─────────────────────────────────────────────────────────────────────────
    match /bills/{companyId}/{branchId}/{rest=**} {
      allow read: if canAccessBranch(companyId, branchId);
      allow create, update: if canUpload(companyId, branchId) &&
        request.resource.size <= 10 * 1024 * 1024;
      allow delete: if canDelete(companyId, branchId);
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Staff Photos: staffPhotos/{companyId}/{branchId}/{filename}
    // ─────────────────────────────────────────────────────────────────────────
    match /staffPhotos/{companyId}/{branchId}/{filename} {
      allow read: if isBranchMember(companyId, branchId);
      allow create, update: if canUpload(companyId, branchId) &&
        request.resource.size <= 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if canDelete(companyId, branchId);
    }

    // A staff member's own photo, from the staff app's settings:
    // staffPhotos/{companyId}/{branchId}/self/{staffId}/{filename}
    match /staffPhotos/{companyId}/{branchId}/self/{staffId}/{filename} {
      allow read: if isBranchMember(companyId, branchId);
      allow create, update: if isBranchMember(companyId, branchId) &&
        userData().get('staffId', '') == staffId &&
        request.resource.size <= 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if (isBranchMember(companyId, branchId) && userData().get('staffId', '') == staffId) ||
        canDelete(companyId, branchId);
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Loan Repayment Receipts: loanRepayments/{companyId}/{segment}/{filename}
    // Note: segment is "{branchId}_to_{otherId}" — company-level check only
    // ─────────────────────────────────────────────────────────────────────────
    match /loanRepayments/{companyId}/{segment}/{filename} {
      allow read: if belongsToCompany(companyId) && userData().role != 'staff';
      allow create, update: if canWriteCompanyLevel(companyId) &&
        request.resource.size <= 10 * 1024 * 1024;
      allow delete: if isAuth() && userData().companyId == companyId &&
        (userData().role == 'owner' || isBranchAdmin(userData()));
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Chat files (roadmap 4.4): chat/{companyId}/{chatId}/{uid}/{filename}
    // Whoever can see the chat (firestore.rules canSeeChat) opens its files;
    // each person uploads only into their own folder, up to 32 MB a file.
    // ─────────────────────────────────────────────────────────────────────────
    function canSeeChat(companyId, chatId) {
      let u = userData();
      let chat = firestore.get(/databases/(default)/documents/companies/$(companyId)/chats/$(chatId)).data;
      return isAuth() && u.companyId == companyId && (
        chat.kind == 'company' ||
        (chat.kind == 'branch' && (isCompanyRole(u) || u.get('branchId', null) == chat.get('branchId', ''))) ||
        ((chat.kind == 'group' || chat.kind == 'direct') && request.auth.uid in chat.get('members', [])));
    }

    match /chat/{companyId}/{chatId}/{uid}/{filename} {
      allow read: if canSeeChat(companyId, chatId);
      allow create: if request.auth.uid == uid && canSeeChat(companyId, chatId) &&
        request.resource.size <= 32 * 1024 * 1024;
      // your own files; management also removes others' (with the message) outside personal chats
      allow delete: if request.auth.uid == uid ||
        (canSeeChat(companyId, chatId) && !chatId.matches('dm_.*') &&
          (isCompanyRole(userData()) || isBranchAdmin(userData()) || userData().role == 'manager'));
    }

    // Issue photos (4.5): issues/{companyId}/{branchId}/{uid}/{filename} —
    // anyone at the branch adds photos (up to 10 MB) and sees them.
    match /issues/{companyId}/{branchId}/{uid}/{filename} {
      allow read: if isBranchMember(companyId, branchId);
      allow create: if request.auth.uid == uid && isBranchMember(companyId, branchId) &&
        request.resource.size <= 10 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth.uid == uid;
    }

    // Company chat stickers: stickers/{companyId}/{filename} — an image up to
    // 1 MB, added by management (owner, super admin, gm, branch admin, manager).
    match /stickers/{companyId}/{filename} {
      allow read: if belongsToCompany(companyId);
      allow create: if belongsToCompany(companyId) &&
        (isCompanyRole(userData()) || isBranchAdmin(userData()) || userData().role == 'manager') &&
        request.resource.size <= 1024 * 1024 && request.resource.contentType.matches('image/.*');
      allow delete: if belongsToCompany(companyId) &&
        (isCompanyRole(userData()) || isBranchAdmin(userData()) || userData().role == 'manager');
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Deny all other paths
    // ─────────────────────────────────────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
