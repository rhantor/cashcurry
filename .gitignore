# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code internal files (worktrees, session data)
.claude/worktrees/

# credentials
serviceAccountKey.json
lib/server/serviceAccountKey.json

certificates
# local emulator data, dev password and account list
.local/
firebase-debug.log
firestore-debug.log
ui-debug.log

# finance golden figures are real client data — keep out of the (public) repo
tests/finance/__golden__/

# a failing golden check writes its full output here
tests/finance/__golden__/*.actual.json

# generated from lib/finance by scripts/build-functions-engine.mjs
functions/engine.cjs
